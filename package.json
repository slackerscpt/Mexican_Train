{
  "name": "mexican-train-scorekeeper",
  "version": "1.0.0",
  "description": "Local score keeper for Mexican Train dominoes, with JSON-file persistence.",
  "main": "server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js",
    "test:unit": "node --test unit-tests/**/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.5.4"
  }
}
